<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 배경이 옅을 때(배경화면이 비칠 때) 머리글: 홈 화면 앱 이름처럼 흰 글자 + 어두운 그림자 → 밝은·어두운 배경화면 모두에서 읽힘 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <!-- 플랫 이모지 스타일일 때 그룹 이모지 이미지 (기본은 숨김) -->
    <ImageView
        android:id="@+id/group_header_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="6dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- 왼쪽: 그룹명 → 앱 열기 -->
    <TextView
        android:id="@+id/group_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:shadowColor="#B3000000"
        android:shadowRadius="4"
        android:shadowDx="0"
        android:shadowDy="1" />

    <!-- 오른쪽: 접기/펼치기 (To-Do 헤더와 동일 구조) -->
    <LinearLayout
        android:id="@+id/group_header_toggle_area"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/group_header_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#B3000000"
            android:shadowRadius="4"
            android:shadowDx="0"
            android:shadowDy="1" />
    </LinearLayout>

</LinearLayout>
